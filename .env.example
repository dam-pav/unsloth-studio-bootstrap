# Required host storage
DATA_DIR=/srv/unsloth
MODELS_PATH=/srv/models

# Optional persistent subdirectories under DATA_DIR
UNSLOTH_WORK_PATH=work
UNSLOTH_STUDIO_PATH=studio-state
UNSLOTH_PROJECTS_PATH=projects
UNSLOTH_UID=1000
UNSLOTH_GID=1000

# Stable releases: latest, an exact release such as 2026.5.7, or nightly
UNSLOTH_VERSION=latest
UNSLOTH_UPDATE_CHECK=1
UNSLOTH_AUTO_UPDATE=1

# SQLite modes: wal (upstream), rollback-journal (rollback journaling), wal-exclusive.
# wal-exclusive prevents access by separate database processes; see docs/sqlite-modes.md.
UNSLOTH_SQLITE_MODE=wal

# bundled uses Unsloth's managed llama.cpp. custom compiles the selected ref.
LLAMA_CPP_MODE=bundled
LLAMA_CPP_REPO=https://github.com/unslothai/llama.cpp.git
LLAMA_CPP_REF=b10079-mix-fb3d4ca
# Required only in custom mode. Multiple architectures use semicolons: 61;86
LLAMA_CUDA_ARCHITECTURES=
LLAMA_SERVER_REBUILD=0
LLAMA_SERVER_FLASH_ATTN=off
LLAMA_SERVER_FIT=off

# NAT/local deployment
UNSLOTH_BIND_ADDRESS=127.0.0.1
UNSLOTH_PORT=8888

# Required only with docker-compose.macvlan.yml
MACVLAN_NETWORK=macvlan_net
UNSLOTH_IPV4_ADDRESS=
UNSLOTH_MAC_ADDRESS=

TZ=Etc/UTC
HF_TOKEN=
UNSLOTH_GPU_DEVICES=all

# Optional published-image overrides
LLAMA_SETUP_IMAGE=ghcr.io/dam-pav/unsloth-studio-bootstrap-llama-setup:latest
UNSLOTH_WEB_IMAGE=ghcr.io/dam-pav/unsloth-studio-bootstrap-web:latest
